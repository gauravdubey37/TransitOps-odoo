# =============================================================================
# TransitOps Environment Configuration
# Copy this file to .env and adjust values for your local environment.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=TransitOps
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:5001/api/v1

# -----------------------------------------------------------------------------
# Backend (Express)
# -----------------------------------------------------------------------------
BACKEND_PORT=5001
PORT=5001
API_PREFIX=/api/v1
JWT_SECRET=change-me-in-production-use-strong-secret
JWT_EXPIRES_IN=15m
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
DB_NAME=transitops

# Default admin credentials (development only)
ADMIN_EMAIL=admin@transitops.local
ADMIN_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Analytics (FastAPI)
# -----------------------------------------------------------------------------
ANALYTICS_PORT=8000
PYTHON_ENV=development
POSTGRES_URI=postgresql://transitops:transitops_dev@transitops-postgres:5432/transitops

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=transitops-postgres
POSTGRES_PORT=5432
POSTGRES_DB=transitops
POSTGRES_USER=transitops
POSTGRES_PASSWORD=transitops_dev
DATABASE_URL=postgresql://transitops:transitops_dev@transitops-postgres:5432/transitops

# Local host access (when running migrations from Windows, not inside Docker)
# POSTGRES_HOST=localhost
# DATABASE_URL=postgresql://transitops:transitops_dev@localhost:5432/transitops
# POSTGRES_URI=postgresql://transitops:transitops_dev@localhost:5432/transitops

# -----------------------------------------------------------------------------
# Neo4j
# -----------------------------------------------------------------------------
NEO4J_HOST=transitops-neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=transitops_dev
NEO4J_DATABASE=neo4j
NEO4J_URI=bolt://transitops-neo4j:7687

# Local development (without Docker)
# NEO4J_HOST=localhost
# NEO4J_URI=bolt://localhost:7687

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=transitops
DOCKER_NETWORK=transitops-network

# -----------------------------------------------------------------------------
# Backup
# -----------------------------------------------------------------------------
BACKUP_DIR=./database/backup
BACKUP_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Seed
# -----------------------------------------------------------------------------
SEED_PROFILE=development
